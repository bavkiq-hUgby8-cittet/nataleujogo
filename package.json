{
  "name": "jogos-de-familia",
  "private": true,
  "description": "Plataforma estática multi-família: quiz, cápsula, bingo, karaokê e jogo da memória.",
  "scripts": {
    "emuladores": "firebase emulators:start --only auth,database",
    "test:regras": "firebase emulators:exec --only auth,database \"node tests/regras.mjs\"",
    "servir": "python3 -m http.server 8765"
  },
  "devDependencies": {
    "firebase-tools": "^14.20.0",
    "playwright": "^1.64.1"
  }
}
